generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WatchedSite {
  id           String     @id @default(cuid())
  url          String
  category     String
  customFields String[]   @default([])
  createdAt    DateTime   @default(now())
  snapshots    Snapshot[]
}

model Snapshot {
  id        String      @id @default(cuid())
  siteId    String
  site      WatchedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  data      Json
  summary   String?
  changes   Json?
  flagged   Json?
  createdAt DateTime    @default(now())

  @@index([siteId, createdAt])
}
